+def _tv(x, p, method, m=None):
+    """Index a production parameter that may be time-invariant or time-varying.
+
+    Legacy shape ``(M,)`` is time-invariant and is returned exactly as before,
+    so existing calibrations are bit-identical. Shape ``(T, M)`` is treated as
+    a time path and indexed with the same convention already used for ``Z``:
+    ``[-1]`` in the steady state, ``[: p.T]`` along the transition.
+
+    This is what lets ``gamma`` (and ``epsilon``) follow a path, so automation
+    can ramp rather than step.
+    """
+    x = np.asarray(x)
+    if x.ndim <= 1:                       # (M,) or scalar -- time-invariant
+        return x[m] if m is not None else x
+    if method == "SS":                    # (T, M) -- time-varying
+        return x[-1, m] if m is not None else x[-1]
+    return x[: p.T, m] if m is not None else x[: p.T]
+
